{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "members", "applicability", "dependencies"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$" },
    "description": { "type": "string" },
    "members": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" }, "uniqueItems": true },
    "applicability": { "type": "object", "additionalProperties": true },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$" }, "uniqueItems": true },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^v[1-9][0-9]*$": { "type": "object", "additionalProperties": true }
      }
    }
  }
}

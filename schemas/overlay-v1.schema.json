{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlay-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleId", "operation", "reason"],
  "properties": {
    "ruleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
    "operation": { "enum": ["disable", "addendum", "replace-with"] },
    "reason": { "type": "string", "minLength": 1 },
    "content": { "type": "string" },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^v[1-9][0-9]*$": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
